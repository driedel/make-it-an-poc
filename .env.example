# Autenticação do webhook /publish — gere o secret com: openssl rand -hex 32
HMAC_SECRET=change-me-run-openssl-rand-hex-32
HMAC_MAX_SKEW=300

# Fila Redis (rede interna do compose)
REDIS_URL=redis://redis:6379/0

# AWS / S3 — em dev o LocalStack aceita qualquer credencial
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=my-static-site
S3_ENDPOINT_URL=http://localstack:4566
S3_USE_PATH_STYLE=true
# Vazio em dev: sem CloudFront local, a invalidação é pulada
CLOUDFRONT_DISTRIBUTION_ID=

# CORS da API (restrinja em produção)
CORS_ORIGINS=*

# Preview nginx local: host usado no rewrite para /{bucket}/{ORIGIN_HOST}/...
ORIGIN_HOST=wordpress

# Hosts internos que aparecem no HTML raspado e são reescritos para caminhos relativos
SCRAPE_INTERNAL_HOSTS=wordpress,localhost:8300

# MariaDB (WordPress)
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=wordpress
MARIADB_ROOT_PASSWORD=rootpassword

# Versão das imagens do serviço no Docker Hub (namespace driedel, tags sem o "v")
MIS_VERSION=0.2.2
